# Noria Ledger environment file. Copy to .env (development) or keep per-environment
# files outside the repo (e.g. /etc/noria/production.env) and pass NORIA_ENV_FILE.
# Secrets do NOT belong here — see secrets/README.md.

# development | staging | production. Destructive scripts refuse to run in production.
NORIA_ENV=development
COMPOSE_PROJECT_NAME=noria-dev

# Registry used for upstream images (mariadb, redis, frappe/erpnext, caddy, bun).
# Images are pinned by digest, so a pull-through mirror (e.g. mirror.gcr.io) yields
# identical content.
UPSTREAM_REGISTRY=docker.io

# Noria images (built locally by `noria.sh build`, or pulled from your registry).
NORIA_BACKEND_IMAGE=noria-ledger/backend
NORIA_EDGE_IMAGE=noria-ledger/edge
NORIA_TAG=dev
NORIA_PULL_POLICY=never
# Optional: CA bundle for TLS-intercepting proxies during image builds (BuildKit
# secret; never stored in images). Example: /etc/ssl/certs/corp-ca.pem
NORIA_BUILD_EXTRA_CA=

# Public edge. ":80" = plain HTTP on NORIA_HTTP_PORT. In production set a domain,
# e.g. "ledger.example.co.ke", and Caddy obtains certificates automatically.
NORIA_SITE_ADDRESS=:80
NORIA_HTTP_PORT=8080
NORIA_HTTPS_PORT=8443
# Frappe desk for operators, bound to 127.0.0.1 only.
NORIA_ADMIN_PORT=8081

# Sites
NORIA_HUB_SITE=hub.noria.localhost
NORIA_CLIENT_SITE_SUFFIX=ledger.internal
# Allow self-service firm sign-up on the login page (rate limited). 0 in production
# until commercial onboarding is defined.
NORIA_ALLOW_FIRM_SIGNUP=1

# Runtime tuning
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
# Separate pool for hub -> client-site calls
GUNICORN_LEDGER_WORKERS=2
GUNICORN_LEDGER_THREADS=4
DB_INNODB_BUFFER_POOL_SIZE=512M
DB_MAX_CONNECTIONS=300
REDIS_CACHE_MAXMEMORY=256mb
